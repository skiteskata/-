// 1. ЖУРНАЛ
class EventLog {
private:
    struct Event {
        std::string type;
        std::string message;
        std::time_t timestamp;
    };
    std::vector<Event> logs;

public:
    void addEvent(const std::string& type, const std::string& message) {
        std::time_t now = std::time(nullptr);
        logs.push_back({ type, message, now });
        std::cout << "[СОБЫТИЕ] [" << type << "] " << message << "\n";
    }

    friend std::ostream& operator<<(std::ostream& os, const EventLog& log) {
        os << "\n--- ЖУРНАЛ СОБЫТИЙ РОБОТА ---\n";
        for (const auto& event : log.logs) {
            char timeStr[100];
            std::strftime(timeStr, sizeof(timeStr), "%H:%M:%S", std::localtime(&event.timestamp));
            os << "[" << timeStr << "] " << std::setw(12) << std::left << event.type
                << " | " << event.message << "\n";
        }
        return os;
    }

    void saveToFile(const std::string& filename) const {
        std::ofstream file(filename);
        if (file.is_open()) {
            file << "--- ЖУРНАЛ СОБЫТИЙ РОБОТА ---\n";
            for (const auto& event : logs) {
                char timeStr[100];
                std::strftime(timeStr, sizeof(timeStr), "%H:%M:%S", std::localtime(&event.timestamp));
                file << "[" << timeStr << "] " << std::setw(12) << std::left << event.type
                    << " | " << event.message << "\n";
            }
            file.close();
            std::cout << "\n[УСПЕХ] Журнал сохранен в файл " << filename << "\n";
        }
    }
};

// 2. БАЗОВЫЙ МОДУЛЬ (Абстрактный класс)
class RobotModule {
protected:
    std::string name;
    double weight;
    double powerConsumption;

public:
    RobotModule(std::string n, double w, double p) : name(n), weight(w), powerConsumption(p) {}
    virtual ~RobotModule() = default;

    std::string getName() const { return name; }
    double getWeight() const { return weight; }
    double getPower() const { return powerConsumption; }

    virtual void activate() const = 0;
    virtual std::string getInfo() const = 0;

    bool operator>(const RobotModule& other) const {
        return this->weight > other.weight;
    }
};

// 3. МОДУЛЬ-ПУШКА
class WeaponModule : public RobotModule {
private:
    int damage;
public:
    WeaponModule(std::string n, double w, double p, int dmg) : RobotModule(n, w, p), damage(dmg) {}
    void activate() const override { std::cout << "  -> " << name << " стреляет! Урон: " << damage << "\n"; }
    std::string getInfo() const override {
        return "Пушка [" + name + "] | Вес: " + std::to_string((int)weight) + "кг | Энергия: " + std::to_string((int)powerConsumption) + "Вт";
    }
};

// 4. МОДУЛЬ-СЕНСОР
class SensorModule : public RobotModule {
private:
    int range;
public:
    SensorModule(std::string n, double w, double p, int r) : RobotModule(n, w, p), range(r) {}
    void activate() const override { std::cout << "  -> " << name << " сканирует местность (радиус " << range << "м).\n"; }
    std::string getInfo() const override {
        return "Сенсор [" + name + "] | Вес: " + std::to_string((int)weight) + "кг | Энергия: " + std::to_string((int)powerConsumption) + "Вт";
    }
};

// 5. РОБОТ (Агрегация)
class Robot {
private:
    std::string modelName;
    std::vector<RobotModule*> modules;
    EventLog log;
    double maxWeight;
    double maxPower;

public:
    Robot(std::string name, double maxW, double maxP)
        : modelName(name), maxWeight(maxW), maxPower(maxP) {
        log.addEvent("СИСТЕМА", "Создан каркас робота: " + modelName);
    }

    ~Robot() {
        for (auto* mod : modules) { delete mod; }
    }

    Robot& operator+=(RobotModule* module) {
        modules.push_back(module);
        log.addEvent("СБОРКА", "Установлен модуль: " + module->getName());
        return *this;
    }

    template <typename T>
    T* getHeaviestModule() {
        T* heaviest = nullptr;
        for (auto* mod : modules) {
            if (T* casted = dynamic_cast<T*>(mod)) {
                if (!heaviest || *casted > *heaviest) heaviest = casted;
            }
        }
        return heaviest;
    }

    void checkStatus() {
        double currentWeight = 0, currentPower = 0;
        for (const auto* mod : modules) {
            currentWeight += mod->getWeight();
            currentPower += mod->getPower();
        }
        std::cout << "\n--- Проверка систем ---\n";
        std::cout << "Общий вес: " << currentWeight << " / " << maxWeight << " кг\n";
        std::cout << "Потребление: " << currentPower << " / " << maxPower << " Вт\n";

        if (currentWeight > maxWeight) log.addEvent("ТРЕВОГА", "Превышен максимальный вес! Робот не поедет.");
        if (currentPower > maxPower) log.addEvent("ТРЕВОГА", "Превышено энергопотребление! Риск отключения.");
    }

    void run() {
        log.addEvent("ЗАПУСК", "Робот " + modelName + " активирован.");
        if (modules.empty()) {
            std::cout << "  -> Робот пуст. Нечего активировать.\n";
        }
        else {
            for (const auto* mod : modules) mod->activate();
        }
        std::cout << "\n";
    }

    void showModules() const {
        std::cout << "\n--- Модули робота " << modelName << " ---\n";
        if (modules.empty()) std::cout << "Модулей нет.\n";
        for (const auto* mod : modules) std::cout << mod->getInfo() << "\n";
    }

    void printLog() const { std::cout << log; }
    void saveLog() const { log.saveToFile("robot_log.txt"); }
};

// MAIN
int main() {
    setlocale(LC_ALL, "ru");

    std::cout << "=== КОНСТРУКТОР МОДУЛЬНОГО РОБОТА ===\n\n";
    Robot myRobot("Скаут-01", 100.0, 500.0);

    int choice = 0;
    while (choice != 5) {
        std::cout << "\n--- МЕНЮ ---\n";
        std::cout << "1. Добавить пушку (Лазер)\n";
        std::cout << "2. Добавить сенсор (Радар)\n";
        std::cout << "3. Проверить характеристики\n";
        std::cout << "4. Запустить робота\n";
        std::cout << "5. Показать журнал, сохранить в файл и выйти\n";
        std::cout << "Выберите действие: ";

        std::cin >> choice;

        switch (choice) {
        case 1: myRobot += new WeaponModule("Лазер", 25.5, 150.0, 80); break;
        case 2: myRobot += new SensorModule("Радар", 15.0, 100.0, 500); break;
        case 3: myRobot.checkStatus(); break;
        case 4: myRobot.run(); break;
        case 5:
            myRobot.showModules();
            myRobot.printLog();
            myRobot.saveLog();
            std::cout << "Выход из программы...\n";
            break;
        default:
            std::cout << "Неверный ввод. Попробуйте снова.\n";
        }
    }

    return 0;
}
