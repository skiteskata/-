#include <iostream>
#include <vector>
#include <string>
#include <ctime>
#include <iomanip>

// 1. ЖУРНАЛ
class EventLog {
private:
    struct Event {
        std::string type;
        std::string message;
        std::time_t timestamp;
    };
    std::vector<Event> logs;

public:
    void addEvent(const std::string& type, const std::string& message) {
        std::time_t now = std::time(nullptr);
        logs.push_back({type, message, now});
        std::cout << "[СОБЫТИЕ] [" << type << "] " << message << "\n";
    }

    friend std::ostream& operator<<(std::ostream& os, const EventLog& log) {
        os << "\n--- ЖУРНАЛ СОБЫТИЙ РОБОТА ---\n";
        for (const auto& event : log.logs) {
            char timeStr[100];
            std::strftime(timeStr, sizeof(timeStr), "%H:%M:%S", std::localtime(&event.timestamp));
            os << "[" << timeStr << "] " << std::setw(12) << std::left << event.type
               << " | " << event.message << "\n";
        }
        return os;
    }
};

// 2. БАЗОВЫЙ МОДУЛЬ
class RobotModule {
protected:
    std::string name;
    double weight;
    double powerConsumption;

public:
    RobotModule(std::string n, double w, double p) : name(n), weight(w), powerConsumption(p) {}
    virtual ~RobotModule() = default;

    std::string getName() const { return name; }
    double getWeight() const { return weight; }
    double getPower() const { return powerConsumption; }

    virtual void activate() const = 0;
    virtual std::string getInfo() const = 0;

    bool operator>(const RobotModule& other) const {
        return this->weight > other.weight;
    }
};

// 3. МОДУЛЬ-ПУШКА
class WeaponModule : public RobotModule {
private:
    int damage;

public:
    WeaponModule(std::string n, double w, double p, int dmg)
        : RobotModule(n, w, p), damage(dmg) {}

    void activate() const override {
        std::cout << "  -> " << name << " стреляет! Урон: " << damage << "\n";
    }

    std::string getInfo() const override {
        return "Пушка [" + name + "] | Вес: " + std::to_string((int)weight) +
               "кг | Энергия: " + std::to_string((int)powerConsumption) + "Вт";
    }
};

// 4. МОДУЛЬ-СЕНСОР
class SensorModule : public RobotModule {
private:
    int range;

public:
    SensorModule(std::string n, double w, double p, int r)
        : RobotModule(n, w, p), range(r) {}

    void activate() const override {
        std::cout << "  -> " << name << " сканирует местность (радиус " << range << "м).\n";
    }

    std::string getInfo() const override {
        return "Сенсор [" + name + "] | Вес: " + std::to_string((int)weight) +
               "кг | Энергия: " + std::to_string((int)powerConsumption) + "Вт";
    }
};

// 5. РОБОТ
class Robot {
private:
    std::string modelName;
    std::vector<RobotModule*> modules;
    EventLog log;

    double maxWeight;
    double maxPower;

public:
    Robot(std::string name, double maxW, double maxP)
        : modelName(name), maxWeight(maxW), maxPower(maxP) {
        log.addEvent("СИСТЕМА", "Создан каркас робота: " + modelName);
    }

    ~Robot() {
        for (auto* mod : modules) {
            delete mod;
        }
    }

    Robot& operator+=(RobotModule* module) {
        modules.push_back(module);
        log.addEvent("СБОРКА", "Установлен модуль: " + module->getName());
        return *this;
    }

    template <typename T>
    T* getHeaviestModule() {
        T* heaviest = nullptr;
        for (auto* mod : modules) {
            if (T* casted = dynamic_cast<T*>(mod)) {
                if (!heaviest || *casted > *heaviest) {
                    heaviest = casted;
                }
            }
        }
        return heaviest;
    }

    void checkStatus() {
        double currentWeight = 0;
        double currentPower = 0;

        for (const auto* mod : modules) {
            currentWeight += mod->getWeight();
            currentPower += mod->getPower();
        }

        std::cout << "\n--- Проверка систем ---\n";
        std::cout << "Общий вес: " << currentWeight << " / " << maxWeight << " кг\n";
        std::cout << "Потребление: " << currentPower << " / " << maxPower << " Вт\n";

        if (currentWeight > maxWeight) {
            log.addEvent("ТРЕВОГА", "Превышен максимальный вес! Робот не поедет.");
        }
        if (currentPower > maxPower) {
            log.addEvent("ТРЕВОГА", "Превышено энергопотребление! Риск отключения.");
        }
    }

    void run() {
        log.addEvent("ЗАПУСК", "Робот " + modelName + " активирован.");
        for (const auto* mod : modules) {
            mod->activate();
        }
        std::cout << "\n";
    }

    void showModules() const {
        std::cout << "\n--- Модули робота " << modelName << " ---\n";
        for (const auto* mod : modules) {
            std::cout << mod->getInfo() << "\n";
        }
    }

    void printLog() const {
        std::cout << log;
    }
};

// MAIN
int main() {
    std::cout << "=== КОНСТРУКТОР МОДУЛЬНОГО РОБОТА ===\n\n";

    Robot myRobot("Скаут-01", 100.0, 500.0);

    WeaponModule* laser = new WeaponModule("Лазер", 25.5, 150.0, 80);
    SensorModule* radar = new SensorModule("Радар", 15.0, 100.0, 500);
    SensorModule* camera = new SensorModule("Камера", 5.0, 50.0, 50);

    myRobot += laser;
    myRobot += radar;
    myRobot += camera;

    myRobot.checkStatus();

    SensorModule* heavySensor = myRobot.getHeaviestModule<SensorModule>();
    if (heavySensor) {
        std::cout << "\n[Анализ] Самый тяжелый сенсор: " << heavySensor->getName() << "\n";
    }

    myRobot.showModules();
    myRobot.run();
    myRobot.printLog();

    return 0;
}
